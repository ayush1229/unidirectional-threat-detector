{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionRecord v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "sensor_id": {
      "type": "string",
      "minLength": 1
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "entity_keys": {
      "type": "object",
      "required": [
        "flow_id",
        "source",
        "destination"
      ],
      "properties": {
        "flow_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "protocol": {
      "type": "string",
      "minLength": 1
    },
    "decision_state": {
      "enum": [
        "BENIGN",
        "KNOWN_ATTACK",
        "UNKNOWN",
        "UNCERTAIN"
      ]
    },
    "primary_class": {
      "enum": [
        "DDoS",
        "PORT_SCAN",
        "DGA",
        "DNS_TUNNEL",
        "C2_BEACONING",
        "BOTNET_HOST",
        "BOTNET_COORDINATION",
        "ENCRYPTED_MALWARE",
        "DATA_EXFILTRATION",
        "BRUTE_FORCE",
        "WEB_ATTACK",
        "ANOMALOUS_UNCLASSIFIED",
        null
      ]
    },
    "labels": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "DDoS",
          "PORT_SCAN",
          "DGA",
          "DNS_TUNNEL",
          "C2_BEACONING",
          "BOTNET_HOST",
          "BOTNET_COORDINATION",
          "ENCRYPTED_MALWARE",
          "DATA_EXFILTRATION",
          "BRUTE_FORCE",
          "WEB_ATTACK"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "label_probabilities": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "DDoS",
          "PORT_SCAN",
          "DGA",
          "DNS_TUNNEL",
          "C2_BEACONING",
          "BOTNET_HOST",
          "BOTNET_COORDINATION",
          "ENCRYPTED_MALWARE",
          "DATA_EXFILTRATION",
          "BRUTE_FORCE",
          "WEB_ATTACK"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "ood",
        "epistemic_proxy",
        "expert_disagreement",
        "overall"
      ],
      "properties": {
        "ood": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "epistemic_proxy": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "expert_disagreement": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "overall": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ood": {
      "type": "object",
      "required": [
        "energy",
        "ae_error",
        "if_score",
        "latent_distance"
      ],
      "properties": {
        "energy": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "ae_error": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "if_score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "latent_distance": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "visibility_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "visibility": {
      "type": "object"
    },
    "history_length": {
      "type": "number",
      "minimum": 0
    },
    "history": {
      "type": "object"
    },
    "threshold_version": {
      "type": "string",
      "minLength": 1
    },
    "thresholds": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "DDoS",
          "PORT_SCAN",
          "DGA",
          "DNS_TUNNEL",
          "C2_BEACONING",
          "BOTNET_HOST",
          "BOTNET_COORDINATION",
          "ENCRYPTED_MALWARE",
          "DATA_EXFILTRATION",
          "BRUTE_FORCE",
          "WEB_ATTACK"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "routing_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "routing": {
      "type": "object"
    },
    "score_presence": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "model_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "object"
    },
    "drift_status": {
      "type": "string",
      "minLength": 1
    },
    "model_profile": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "event_id",
    "sensor_id",
    "event_time",
    "entity_keys",
    "protocol",
    "decision_state",
    "primary_class",
    "labels",
    "label_probabilities",
    "confidence",
    "uncertainty",
    "ood",
    "visibility_ratio",
    "visibility",
    "history_length",
    "history",
    "threshold_version",
    "thresholds",
    "routing_policy_version",
    "routing",
    "score_presence",
    "reason_codes",
    "model_versions",
    "evidence",
    "drift_status",
    "model_profile"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "decision_state": {
            "const": "KNOWN_ATTACK"
          }
        }
      },
      "then": {
        "properties": {
          "labels": {
            "type": "object",
            "minProperties": 1
          },
          "primary_class": {
            "enum": [
              "DDoS",
              "PORT_SCAN",
              "DGA",
              "DNS_TUNNEL",
              "C2_BEACONING",
              "BOTNET_HOST",
              "BOTNET_COORDINATION",
              "ENCRYPTED_MALWARE",
              "DATA_EXFILTRATION",
              "BRUTE_FORCE",
              "WEB_ATTACK"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_state": {
            "enum": [
              "BENIGN",
              "UNCERTAIN"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "labels": {
            "type": "object",
            "maxProperties": 0
          },
          "primary_class": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_state": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "labels": {
            "type": "object",
            "maxProperties": 0
          },
          "primary_class": {
            "const": "ANOMALOUS_UNCLASSIFIED"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  ]
}
