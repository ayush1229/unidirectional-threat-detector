{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IncidentUpdate v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "sensor_id": {
      "type": "string",
      "minLength": 1
    },
    "entity": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "enum": [
        "create",
        "update",
        "close",
        "reopen"
      ]
    },
    "status": {
      "enum": [
        "open",
        "closed"
      ]
    },
    "first_seen": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "severity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timeline": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "decision_id",
          "event_time",
          "labels",
          "evidence"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "event_time": {
            "type": "string",
            "format": "date-time"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "object"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "incident_id",
    "sensor_id",
    "entity",
    "family",
    "action",
    "status",
    "first_seen",
    "last_seen",
    "count",
    "labels",
    "severity",
    "reason_codes",
    "timeline"
  ]
}
